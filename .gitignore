# data is not committed
data/
results/reports/*
results/traces/*
!results/**/.gitkeep

# secrets — never commit the real key
.env
.env.local

# macOS
.DS_Store

# python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/

# R session artifacts (RStudio leaves these next to the manuscript)
paper/.Rhistory
paper/.RData
paper/.Rproj.user/
experiments/variants/variant_results.json
annotation/oracle/evidence_spans_completed.csv
.Rhistory

# raw API-call checkpoints (resumable runs)
results/*.jsonl
