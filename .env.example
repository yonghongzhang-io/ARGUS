# Copy this file to `.env` and fill in your real key. `.env` is gitignored.
#   cp .env.example .env
# Then edit .env. Any LLM run (assessor="llm") loads it automatically — no need
# to `export` the key every shell. An explicit `export` still overrides the file.

OPENAI_API_KEY=
# Optional: which model the LLM assessor / relevance gate use (default gpt-4o).
# ARGUS_LLM_MODEL=gpt-4o

# Optional: a compatible gateway / proxy base URL.
# OPENAI_BASE_URL=

# --- cross-model runs (experiments/models/run_crossmodel.py) ---------------
# Keys for the other providers in config/models.yaml. Only needed for the
# model you actually run; the driver maps each to the right endpoint.
# ANTHROPIC_API_KEY=        # Claude (provider: anthropic)
# GEMINI_API_KEY=           # Gemini (OpenAI-compatible endpoint)
# MOONSHOT_API_KEY=         # Kimi   (OpenAI-compatible endpoint)
# Ollama (llama3.1:8b) is local and needs no key:
#   brew install ollama && ollama pull llama3.1:8b
