# Copy this file to `.env` and fill in your real key. `.env` is gitignored.
#   cp .env.example .env
# Then edit .env. Any LLM run (assessor="llm") loads it automatically — no need
# to `export` the key every shell. An explicit `export` still overrides the file.

OPENAI_API_KEY=sk-your-key-here

# Optional: which model the LLM assessor / relevance gate use (default gpt-4o).
# ARGUS_LLM_MODEL=gpt-4o

# Optional: a compatible gateway / proxy base URL.
# OPENAI_BASE_URL=
